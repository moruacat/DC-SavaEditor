{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "恶魔连结存档编辑器",
  "version": "0.1.5",
  "identifier": "com.dc.saveeditor",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "恶魔连结 存档编辑器",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
